# Copy to .env and adjust before `docker compose up`.

# --- Database ---
POSTGRES_PASSWORD=changeme

# --- Local admin bootstrap ---
# On first startup, if no user with this name exists, one is created as admin.
# Ignored if the user already exists (password will NOT be reset).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-please

# --- OIDC (Zitadel) -- optional; if unset, only local login is offered ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=

# --- Optional tuning ---
MAX_UPLOAD_BYTES=536870912
APP_PORT=8080

# --- Security ---
# 32-byte key for at-rest encryption of uploads and stored secrets.
# Generate with: openssl rand -hex 32
# Without it, files are stored UNENCRYPTED (a warning is logged).
FILE_ENCRYPTION_KEY=

# --- Storage quotas (bytes; 0 = unlimited) ---
#QUOTA_USER_BYTES=21474836480     # per non-admin user, default 20 GiB
#QUOTA_USER_FILES=1000            # active files per non-admin user
#QUOTA_TOTAL_BYTES=0              # instance-wide ceiling
#DISK_MIN_FREE_BYTES=1073741824   # refuse uploads below this free space
