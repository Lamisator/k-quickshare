# Copy to .env and adjust before `docker compose up`.

# --- Database ---
POSTGRES_PASSWORD=changeme

# --- Local admin bootstrap ---
# On first startup, if no user with this name exists, one is created as admin.
# Ignored if the user already exists (password will NOT be reset).
ADMIN_USERNAME=admin
# At least 12 characters, or the bootstrap is skipped and logs why.
ADMIN_PASSWORD=changeme-please

# --- OIDC (Zitadel) -- optional; if unset, only local login is offered ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=

# --- Optional tuning ---
MAX_UPLOAD_BYTES=536870912
APP_PORT=8080

# --- Security ---
# 32-byte key protecting short secrets in the settings table (principally the
# OIDC client secret). Generate with: openssl rand -hex 32
# REQUIRED — the app refuses to start without it. (Only for local development
# you may instead set ALLOW_UNENCRYPTED_SECRETS=true.)
#
# It does NOT protect uploaded files: those are encrypted in the browser under
# a key the server never sees, so losing this key does not lose any file.
FILE_ENCRYPTION_KEY=

# CIDRs of reverse proxies whose X-Forwarded-For header is trusted for
# rate limiting. Leave empty ONLY when clients connect to the app directly.
#
# Behind a reverse proxy this is required: without it every visitor keys to the
# proxy's address, so the login and share-password limits apply to the whole
# instance at once and one person guessing locks out everyone. The production
# file (deploy/docker-compose.yml) refuses to start without it; this local one
# does not, because a direct-connection dev run genuinely wants it empty.
#TRUSTED_PROXY_CIDRS=172.16.0.0/12

# --- Storage quotas (bytes; 0 = unlimited) ---
#
# QUOTA_USER_* are only the INITIAL default, used until an admin saves the
# per-user quota on /admin/settings. After that the database wins and changing
# these has no effect. Per-user overrides live on /admin/users.
#QUOTA_USER_BYTES=21474836480     # per non-admin user, default 20 GiB
#QUOTA_USER_FILES=1000            # active files per non-admin user
#
# These two are infrastructure limits and stay environment-only.
#QUOTA_TOTAL_BYTES=0              # instance-wide ceiling
#DISK_MIN_FREE_BYTES=1073741824   # refuse uploads below this free space
